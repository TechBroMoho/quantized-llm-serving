  "config_yaml": "# Phase 6 performance benchmarks (ADR-020 windows, ADR-021 prompts).\n# Every run embeds this file and its SHA-256 in its results.\n# Point timings were revised after the AWQ probe (probe-20260923T213438Z):\n# E2E p50 2.42 s at c=1 and 34.4 s at c=256. Rule (ADR-020): warmup_s >=\n# ramp_s + one expected E2E, with the other systems' E2E extrapolated.\nname: phase6-bench\ngpu: L40S\nmodel:\n  id: Qwen/Qwen3-8B\n  revision: b968826d9c46dd6066d109eabc6255188de91218\nquantization_config: phase4_quantize.yaml  # where Phase 4 wrote AWQ/GPTQ\n\n# The checkpoints must match the files Phase 4 produced, and Phase 5 measured\n# accuracy on, byte for byte (sha256), before any GPU time is spent.\nexpected_checkpoints:\n  bf16: results/quantization/phase4/download-20260923T102838Z/manifest.json\n  awq: results/quantization/phase4/quantize-awq-20260923T103930Z/summary.json\n  gptq: results/quantization/phase4/quantize-gptq-20260923T121835Z/summary.json\n\nprompts:  # W1: exact 512-token windows of WikiText-103 (ADR-021)\n  dataset: Salesforce/wikitext\n  revision: b08601e04326c79dfdd32d625aee71d232d685c3\n  files:\n    - wikitext-103-raw-v1/train-00000-of-00002.parquet\n    - wikitext-103-raw-v1/train-00001-of-00002.parquet\n  input_tokens: 512\n  count: 50000  # > the most requests any lifetime can send (~25k planned)\n  oversample: 1.5  # sample from the first 75,000 windows\n  seed: 20260923\n\nworkload:\n  input_tokens: 512\n  output_tokens: 256\n  seed: 0\n  client_processes: 2  # ADR-013\n  # In-Modal capacity (loadtest-check-20260923T205147Z). A point receiving more\n  # than a third of this fails ADR-005's 3x headroom rule and is not accepted.\n  validated_client_chunks_per_s: 9124.1\n  idle_timeout_s: 900\n\nvllm:\n  health_timeout_s: 900\n  engine_args:\n    - --dtype\n    - bfloat16\n    - --max-model-len\n    - \"1024\"  # 512 + 256 = 768 tokens per request\n    - --gpu-memory-utilization\n    - \"0.90\"\n    - --max-num-seqs\n    - \"256\"\n    - --seed\n    - \"0\"\n    - --no-enable-prefix-caching  # unique prompts and no cache reuse (SPEC \u00a76)\n    - --generation-config\n    - vllm  # ignore the checkpoint's sampling defaults\n    - --disable-uvicorn-access-log\n    # No --enforce-eager: performance runs use CUDA graphs.\n\nhf:\n  dtype: bfloat16\n  attn_implementation: sdpa\n  health_timeout_s: 600\n  batch_wait_ms: 50\n  oom_candidates: [8, 16, 32, 48, 64, 96, 128]\n\n# Steady-state points (ADR-020): users start staggered over ramp_s; the\n# window opens at warmup_s (>= ramp_s + one expected E2E).\npoints:\n  c1: {concurrency: 1, ramp_s: 0, warmup_s: 15, window_s: 120, timeout_s: 600}\n  c4: {concurrency: 4, ramp_s: 5, warmup_s: 20, window_s: 120, timeout_s: 600}\n  c16: {concurrency: 16, ramp_s: 8, warmup_s: 25, window_s: 120, timeout_s: 600}\n  c64: {concurrency: 64, ramp_s: 15, warmup_s: 40, window_s: 180, timeout_s: 600}\n  c128: {concurrency: 128, ramp_s: 20, warmup_s: 50, window_s: 180, timeout_s: 600}\n  c256: {concurrency: 256, ramp_s: 30, warmup_s: 80, window_s: 180, timeout_s: 600}\n  # AWQ follow-up (ADR-022): timings adapt at c >= 128; all-at-once start.\n  c256-sync: {concurrency: 256, ramp_s: 0, warmup_s: 80, window_s: 180, timeout_s: 900, diagnostic: true, adapt_ramp: false}\n  probe-c1: {concurrency: 1, ramp_s: 0, warmup_s: 10, window_s: 60, timeout_s: 600}\n  probe-c256: {concurrency: 256, ramp_s: 30, warmup_s: 60, window_s: 90, timeout_s: 600}\n  # HF: naive queues every request behind the others (~7 s each, estimated),\n  # so E2E grows with concurrency; static batches of B.\n  hf-c4: {concurrency: 4, ramp_s: 5, warmup_s: 40, window_s: 120, timeout_s: 900}\n  hf-c16: {concurrency: 16, ramp_s: 8, warmup_s: 125, window_s: 180, timeout_s: 900}\n  hf-cB: {concurrency: B, ramp_s: 10, warmup_s: 60, window_s: 180, timeout_s: 900}\n  hf-c2B: {concurrency: 2B, ramp_s: 20, warmup_s: 90, window_s: 180, timeout_s: 900}\n\n# One server lifetime each. \"-rK\" repeats a point. `repeat_best` repeats the\n# sweep's best passing point that many times (ADR-022). At c >= 128 timings\n# adapt to the expected request duration (ADR-022); `e2e_seeds` are durations\n# measured earlier (seconds, by concurrency).\nlifetimes:\n  probe:\n    variant: awq\n    points: [probe-c1, probe-c256]\n  awq:  # run 2026-09-23 (awq-20260923T220125Z), before ADR-022\n    variant: awq\n    points: [c1, c4, c16, c64, c128, c256, c1-r2, c256-r2, c1-r3, c256-r3]\n    cross_check:  # vllm bench serve at matching settings (random 512/256 prompts)\n      - {concurrency: 1, num_prompts: 30}\n      - {concurrency: 64, num_prompts: 640}\n      - {concurrency: 256, num_prompts: 2048}\n  awq-followup:  # ADR-022: a 4th c=1, the c=128 peak twice, c=256 re-timed\n    variant: awq\n    points: [c1-r4, c128-r2, c128-r3, c256, c256-sync]\n    e2e_seeds: {128: 14.87, 256: 35.60}  # awq-20260923T220125Z medians\n  bf16:\n    variant: bf16\n    points: [c1, c4, c16, c64, c128, c256, c1-r2, c1-r3]\n    repeat_best: 2\n  hf-naive:\n    variant: bf16\n    engine: hf\n    mode: naive\n    points: [c1, hf-c4, hf-c16]\n    repeat_best: 2\n  hf-static:\n    variant: bf16\n    engine: hf\n    mode: static\n    points: [c4, c16, hf-cB, hf-c2B]\n    repeat_best: 2\n  gptq:\n    variant: gptq\n    points: [c1, c4, c16, c64, c128, c256]\n    repeat_best: 2\n  gptq-trimmed:  # the budget cut of ADR-022 \u00a75: GPTQ without c=256\n    variant: gptq\n    points: [c1, c4, c16, c64, c128]\n    repeat_best: 2\n  # Max-batch lifetimes have no sweep, so no repeats (SPEC \u00a76: x1). Seeds from\n  # Little's law on AWQ's measured rates: 256 users / (16 / 3.74 s) = 59.8 s,\n  # 256 / (64 / 8.19 s) = 32.8 s.\n  maxbatch-16:\n    variant: awq\n    extra_engine_args: [--max-num-seqs, \"16\"]\n    points: [c256]\n    e2e_seeds: {256: 59.8}\n  maxbatch-64:\n    variant: awq\n    extra_engine_args: [--max-num-seqs, \"64\"]\n    points: [c256]\n    e2e_seeds: {256: 32.8}\n",
